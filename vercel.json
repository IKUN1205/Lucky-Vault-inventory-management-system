{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cash-alert-eod",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/sync-singles-sheet",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/sync-slabs-sheet",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/audit-cron",
      "schedule": "45 * * * *"
    },
    {
      "path": "/api/weekly-buy-report",
      "schedule": "0 16 * * 1"
    },
    {
      "path": "/api/weekly-usage-digest",
      "schedule": "15 16 * * 1"
    },
    {
      "path": "/api/daily-usage-report",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/sync-digest-eod",
      "schedule": "0 0 * * *"
    }
  ]
}
